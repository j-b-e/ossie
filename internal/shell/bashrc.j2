if [[ -f "/etc/bash.bashrc" ]] ; then
  source "/etc/bash.bashrc"
fi
if [[ -f "$HOME/.bashrc" ]] ; then
  source "$HOME/.bashrc"
fi
export {{ .OsEnvFileKey }}="{{ .osrc }}"
export {{ .PromptFileKey }}="{{ .promptfile }}"
export {{ .SessionFileKey }}="{{ .sessionfile }}"


set -o allexport
source ${{ .OsEnvFileKey }}
set +o allexport
function _ossie_exec_ () {
  export {{ .nested_marker }}
  export {{ .OsEnvFileKey }}="{{ .osrc }}"
  export {{ .SessionFileKey }}="{{ .sessionfile }}"
  set -o allexport
  source ${{ .SessionFileKey }}
  set +o allexport
{{- if .protectenv }}
  unset ${!OS_*}
  set -o allexport
  source ${{ .OsEnvFileKey }}
  set +o allexport
{{ end }}
}

{{ if .aliases -}}
alias os=openstack
alias o=openstack
{{ end -}}
function osenv () {
  while IFS= read -r line; do
    if [[ "$line" == *"OS_PASSWORD"* ]]; then
      echo 'OS_PASSWORD="****"'
    else
      echo ${line/export/}
    fi
  done < "${{ .OsEnvFileKey }}"
}
trap '_ossie_exec_' DEBUG
_ossie_OLDPS="$PS1"

PS1="[$(<{{ .promptfile }})]$_ossie_OLDPS"
